# Copy to .env and fill in. .env is gitignored and never committed.
# Loaded with `node --env-file=.env`, so no dotenv dependency is required.

PORT=8787
CORS_ORIGINS=http://localhost:4200

# Durable storage. Unset keeps rooms in memory, which loses them on restart.
# Set, the server migrates the schema at boot and refuses to start if it can't.
# DATABASE_URL=postgres://user:password@localhost:5432/keel
# DATABASE_POOL_MAX=10

# Architecture review. Set exactly one; Anthropic wins if both are present.
# Leaving both unset disables only the review endpoint. The canvas and the
# deterministic rule engine work fully without either.
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...

# Override the default model for whichever provider is selected.
# Defaults: claude-opus-5 (Anthropic), gemini-3.7-flash (Gemini).
# REVIEW_MODEL=

# GitHub/Google sign-in. Identity-only: rooms stay open to anyone with the
# link either way, this only replaces the random guest name in presence with
# the signed-in user's real name/avatar. Set a provider's id+secret pair to
# enable it; leaving a pair unset disables only that provider's login route.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Required once any provider above is enabled. Signs the session cookie.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=

# Base URL used to build OAuth callback URIs (must match what's registered
# with GitHub/Google). Defaults to http://localhost:8787 for local dev.
# PUBLIC_URL=

# Set to true only behind a proxy that sets X-Forwarded-For (Render does).
# TRUST_PROXY=false

# Per-client request budgets, per minute.
# RATE_LIMIT_REVIEW_PER_MIN=10
# RATE_LIMIT_OBSERVATIONS_PER_MIN=120
# RATE_LIMIT_VALIDATE_PER_MIN=300

# Collaboration socket bounds.
# WS_MAX_MESSAGE_BYTES=2097152
# WS_MESSAGES_PER_SECOND=200
# ROOM_MAX_BYTES=16777216

# Narrow which models /api/review may call (comma-separated). The default
# model is always allowed.
# REVIEW_ALLOWED_MODELS=
