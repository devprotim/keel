# Copy to .env and fill in. .env is gitignored and never committed.
# Loaded with `node --env-file=.env`, so no dotenv dependency is required.

PORT=8787
CORS_ORIGINS=http://localhost:4200

# Architecture review. Set exactly one; Anthropic wins if both are present.
# Leaving both unset disables only the review endpoint. The canvas and the
# deterministic rule engine work fully without either.
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...

# Override the default model for whichever provider is selected.
# Defaults: claude-opus-5 (Anthropic), gemini-3.7-flash (Gemini).
# REVIEW_MODEL=
